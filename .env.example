# The app runs out-of-the-box with public TheSportsDB defaults —
# you only need a .env file to OVERRIDE them.
#
# To customise: copy this file to .env and adjust the values.
# TheSportsDB API — https://www.thesportsdb.com/api.php

# Base URL for the API (no trailing slash). Default:
VITE_SPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# API key. Default is the free public test key "3".
VITE_SPORTSDB_API_KEY=3
